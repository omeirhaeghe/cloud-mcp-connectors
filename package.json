{
  "name": "cloud-connectors",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source catalog of remote-MCP connectors to popular SaaS APIs.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./connectors/*' --filter='./apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
